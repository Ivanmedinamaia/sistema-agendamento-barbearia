# Copie este arquivo para .env e preencha os valores

# Porta do servidor
PORT=3000

# Endereço do frontend autorizado pelo CORS
FRONTEND_URL=http://localhost:5173

# String de conexão do MongoDB (obrigatória)
MONGODB_URI=mongodb://localhost:27017/barbearia

# Chave usada para assinar os tokens JWT (obrigatória; use um valor longo e aleatório)
JWT_SECRET=troque_por_uma_chave_longa_e_aleatoria

# Opcional: quantidade de proxies na frente da API (ex.: 1 no Render ou Railway)
TRUST_PROXY=
